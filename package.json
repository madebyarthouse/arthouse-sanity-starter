{
  "name": "arthouse-sanity-starter-react",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "test": "vitest run",
    "test:smoke": "node tests/run-smoke.mjs",
    "cf-typegen": "wrangler types --include-runtime false",
    "postinstall": "wrangler types --include-runtime false",
    "rr:typegen": "react-router typegen",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build",
    "sanity:deploy": "sanity deploy",
    "sanity:extract": "sanity schema extract --path ./app/sanity/schema.json",
    "sanity:typegen": "sanity typegen generate",
    "sanity:types": "pnpm sanity:extract && pnpm sanity:typegen",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "pnpm cf-typegen && pnpm sanity:types && pnpm rr:typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@c15t/react": "^1.8.2",
    "@portabletext/react": "^3.2.1",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@sanity/client": "^7.9.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.0.2",
    "@sanity/preview-url-secret": "^2.1.14",
    "@sanity/react-loader": "^1.11.18",
    "@sanity/vision": "^4.5.0",
    "@sanity/visual-editing": "^3.0.3",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "groq": "^4.5.0",
    "isbot": "^5.1.27",
    "lucide-react": "^1.42.0",
    "posthog-js": "^1.307.2",
    "pretty-cache-header": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.3.8",
    "react-router": "8.3.0",
    "sanity": "^4.5.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.0",
    "sanity-plugin-media": "^4.1.0",
    "shadcn": "^4.21.0",
    "styled-components": "^6.1.19",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
