{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arthouse-sanity-starter",
  "account_id": "2c9fb1653ddb6954dedcb6ece9f5affe",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "main": "./workers/app.ts",

  // Workers Cache: MISS → HIT for responses that opt into public caching.
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },

  // Non-secret runtime and build variables belong here. Put tokens and
  // session secrets in .dev.vars locally or in Cloudflare Variables & Secrets.
  "vars": {
    "VITE_SANITY_PROJECT_ID": "replace-me",
    "VITE_SANITY_DATASET": "production",
    "VITE_SANITY_API_VERSION": "2024-02-13",
    "VITE_SANITY_STUDIO_URL": "https://your-domain.example/studio",
    "VITE_SANITY_STUDIO_PREVIEW_ORIGIN": "https://your-domain.example",
    "SITE_URL": "https://your-domain.example",
    "PRODUCTION_URL": "https://your-domain.example"
  }
}
